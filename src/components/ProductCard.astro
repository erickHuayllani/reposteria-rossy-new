---
const { product } = Astro.props;
---

<article class="bg-white rounded-2xl shadow p-4 flex flex-col">
  <img 
    src={product.imagen} 
    alt={product.nombre} 
    class="rounded-xl h-44 w-full object-cover mb-3" 
  />

  <h3 class="font-semibold">{product.nombre}</h3>

  <p class="text-sm text-gray-500 flex-1">{product.descripcion}</p>

  <div class="mt-4 flex items-center justify-between">
    <div class="text-lg font-bold">${product.precio?.toFixed(2)}</div>

    <button 
      class="add-to-cart bg-orange-500 text-white px-3 py-1 rounded-lg"
      data-id={product.id}
      data-nombre={product.nombre}
      data-precio={product.precio}
      data-imagen={product.imagen}
    >
      Agregar
    </button>
  </div>
</article>

<!-- 🛒 Script para agregar al carrito -->
<script client:load>
  import { addToCart } from "../js/cart.js";

  document.querySelectorAll(".add-to-cart").forEach(btn => {
    btn.addEventListener("click", () => {
      addToCart({
        id: btn.dataset.id,
        nombre: btn.dataset.nombre,
        precio: parseFloat(btn.dataset.precio),
        imagen: btn.dataset.imagen
      });
    });
  });
</script>
