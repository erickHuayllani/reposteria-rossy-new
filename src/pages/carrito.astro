---
import BaseLayout from "../layouts/BaseLayout.astro";
import { supabase } from "../lib/supabase.js";
import { enviarWhatsApp } from "../utils/whatsapp.js";

let { data: products, error } = await supabase.from("productos").select("*");
if (!products) products = [];
---

<BaseLayout title="Carrito - Repostería D'Rossy">
  <link rel="stylesheet" href="/src/styles/carrito.css" />

  <!-- AQUÍ VA TODO TU HTML ORIGINAL DEL CARRITO -->

  <script is:inline>
    const cartList = document.getElementById('cart-list');
    const totalSpan = document.getElementById('total');
    const checkoutBtn = document.getElementById('checkout-btn');

    let cart = JSON.parse(localStorage.getItem('cart') || '[]');

    /* =======================
       🔥 PROCESAR PEDIDO
    ======================== */
    async function procesarPedido() {
      const total = cart.reduce((s, i) => s + i.price * i.qty, 0);

      // Obtener usuario de Supabase
      const { data: userData } = await supabase.auth.getUser();
      const user = userData?.user;

      if (!user) {
        alert("Debes iniciar sesión para continuar.");
        return;
      }

      // Insertar pedido en Supabase
      const { data: pedido, error } = await supabase
        .from("pedidos")
        .insert({
          productos: cart,
          total: total,
          user_email: user.email,
        })
        .select()
        .single();

      if (error) {
        alert("Error al registrar el pedido.");
        return;
      }

      // Preparar datos para WhatsApp
      const pedidoCreado = {
        id: pedido.id,
        total,
        productos: cart,
        user_email: user.email
      };

      await enviarWhatsApp(pedidoCreado);

      alert("🎉 Pedido enviado correctamente!");

      cart = [];
      localStorage.removeItem("cart");
      renderCart();
    }

    checkoutBtn.addEventListener("click", procesarPedido);

    /* =======================
       🧁 RENDERIZAR CARRITO
    ======================== */
    function renderCart() {
      cartList.innerHTML = '';
      let total = 0;

      cart.forEach(item => {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between bg-rose-50 p-3 rounded-lg shadow-sm';

        li.innerHTML = `
          <div class="flex items-center gap-3">
            <img src="${item.img}" class="w-12 h-12 rounded-md object-cover" />
            <div>
              <strong>${item.name}</strong><br>
              <small>$${item.price} x ${item.qty}</small>
            </div>
          </div>
        `;

        cartList.appendChild(li);
        total += item.price * item.qty;
      });

      totalSpan.textContent = `$${total.toFixed(2)}`;
    }

    renderCart();
  </script>
</BaseLayout>
