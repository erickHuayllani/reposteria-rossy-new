---
import BaseLayout from "../layouts/BaseLayout.astro";
import CartClient from "../components/cart/CartClient.jsx";
---

<BaseLayout title="Carrito - Repostería D'Rossy">
  <div class="min-h-screen bg-gradient-to-b from-yellow-50 to-orange-50 p-6">
    <h1 class="text-4xl font-bold text-center mb-8 text-orange-600 drop-shadow-lg">
      🛒 Tu Carrito
    </h1>

    <div class="max-w-3xl mx-auto grid md:grid-cols-3 gap-6">
      <!-- Catálogo o lista de productos (izquierda) -->
      <div class="md:col-span-2">
        <CartClient client:load />
      </div>

      <!-- Resumen de compra (derecha) -->
      <aside class="bg-white rounded-2xl shadow p-6 flex flex-col space-y-4">
        <h2 class="text-xl font-bold mb-4">Resumen del pedido</h2>
        <ul id="cart-list" class="space-y-3"></ul>

        <div class="flex justify-between font-bold text-lg mt-2">
          <span>Total:</span>
          <span id="total">$0.00</span>
        </div>

        <button id="checkout-btn" class="w-full bg-orange-500 text-white py-2 rounded-lg hover:bg-orange-600 transition-colors">
          🛒 Realizar Pedido
        </button>
      </aside>
    </div>
  </div>

  <script is:inline>
    const cartList = document.getElementById('cart-list');
    const totalSpan = document.getElementById('total');
    const checkoutBtn = document.getElementById('checkout-btn');

    let cart = JSON.parse(localStorage.getItem('cart') || '[]');

    function renderCart() {
      cartList.innerHTML = '';
      let total = 0;

      cart.forEach((item, index) => {
        const li = document.createElement('li');
        li.className = 'flex items-center justify-between bg-rose-50 p-3 rounded-lg shadow-sm hover:shadow-md transition-all animate-fade-in';
        li.innerHTML = `
          <div class="flex items-center gap-3">
            <img src="${item.img}" class="w-12 h-12 rounded-md object-cover" />
            <div>
              <strong>${item.name}</strong><br>
              <small>$${item.price} x ${item.qty}</small>
            </div>
          </div>
          <button data-index="${index}" class="text-red-500 font-bold hover:text-red-700 transition-colors">✕</button>
        `;
        cartList.appendChild(li);

        // botón eliminar
        li.querySelector('button').addEventListener('click', e => {
          const i = Number(e.target.dataset.index);
          cart.splice(i, 1);
          localStorage.setItem('cart', JSON.stringify(cart));
          renderCart();
        });

        total += item.price * item.qty;
      });

      totalSpan.textContent = `$${total.toFixed(2)}`;
    }

    renderCart();

    async function procesarPedido() {
      const total = cart.reduce((s, i) => s + i.price * i.qty, 0);

      if (cart.length === 0) {
        alert("Tu carrito está vacío.");
        return;
      }

      // Aquí puedes integrar Supabase o WhatsApp
      alert(`🎉 Pedido enviado correctamente!\nTotal: $${total.toFixed(2)}`);

      cart = [];
      localStorage.removeItem('cart');
      renderCart();
    }

    checkoutBtn.addEventListener("click", procesarPedido);
  </script>

  <style>
    /* Animación simple al aparecer los productos */
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-in {
      animation: fadeIn 0.3s ease forwards;
    }
  </style>
</BaseLayout>
