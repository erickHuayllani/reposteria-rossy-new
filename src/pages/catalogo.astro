---
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogReactWrapper from '../components/cart/CatalogReactWrapper.jsx';
import { supabase } from '../lib/supabase.js';

// Obtener productos desde Supabase
const { data: products, error } = await supabase
  .from("productos")
  .select("*")
  .order("created_at", { ascending: false });

if (error) {
  console.error("Error cargando productos:", error);
}
---

<BaseLayout title="Catálogo - Repostería D'Rossy">

  <div class="min-h-screen bg-gradient-to-b from-yellow-50 to-orange-50 p-6">
    <h1 class="text-4xl font-bold mb-8 text-center text-orange-600 drop-shadow-lg">
      🌟 Catálogo de Productos 🌟
    </h1>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
      {products?.length > 0 ? (
        <CatalogReactWrapper client:load />
      ) : (
        <p class="text-gray-500 text-lg col-span-full text-center mt-4">
          No hay productos disponibles.
        </p>
      )}
    </div>
  </div>

  <style>
    /* Animación de entrada de las tarjetas */
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .product-card {
      animation: fadeInUp 0.5s ease forwards;
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .product-card:hover {
      transform: scale(1.05);
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }

    .add-to-cart-btn {
      transition: transform 0.2s ease, background-color 0.2s ease;
    }

    .add-to-cart-btn:hover {
      transform: scale(1.1);
      background-color: #16a34a; /* verde más intenso */
    }
  </style>
</BaseLayout>
